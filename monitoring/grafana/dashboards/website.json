    {
      "id": 11,
      "title": "Время обработки запросов",
      "type": "timeseries",
      "description": "Время обработки на сервере до формирования ответа. Не включает передачу файла по сети и отрисовку в браузере. При отсутствии запросов показан 0.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(legal_http_request_duration_seconds_sum{job=\"website\",source=~\"$source\"}[$__rate_interval])) / clamp_min(sum(rate(legal_http_request_duration_seconds_count{job=\"website\",source=~\"$source\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "Среднее",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(legal_http_request_duration_seconds_bucket{job=\"website\",source=~\"$source\"}[$__rate_interval]))) >= 0) or vector(0)",
          "legendFormat": "95-й процентиль",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,

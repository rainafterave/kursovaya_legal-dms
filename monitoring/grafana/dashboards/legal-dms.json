{
  "id": null,
  "uid": "legal-dms",
  "title": "Архив документов — контейнеры",
  "tags": [
    "Docker",
    "Курсовая"
  ],
  "description": "Реальные метрики Docker API → Prometheus → Grafana. Выберите один или несколько сервисов.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Контейнеров приложения",
      "type": "stat",
      "description": "Число недавно наблюдавшихся контейнеров выбранных сервисов. Это не проверка HTTP-здоровья приложения.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(time() - legal_container_last_seen_seconds{service=~\"$service\"} < 30)",
          "legendFormat": "Контейнеров приложения",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "CPU суммарно",
      "type": "stat",
      "description": "100% соответствует одному полностью занятому ядру CPU.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(legal_container_cpu_seconds_total{service=~\"$service\"}[1m]) * 100)",
